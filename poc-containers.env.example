# Copie este arquivo para um caminho local nao versionado e preencha os valores.
# Exemplo: Copy-Item poc-containers.env.example .env.poc
#          docker compose --env-file .env.poc -f compose-poc.yml up --build

COUCHDB_USERNAME=
COUCHDB_PASSWORD=
SIMTR_API_KEY=

COUCHDB_DATABASE=conformidade
# O modelo deve existir previamente no Ollama local em http://localhost:11434.
OLLAMA_MODEL=llama3.2:3b

SIMTR_HUB_HTTP_PORT=8080
COUCHDB_HTTP_PORT=15984
VALKEY_PORT=16379
SIMTR_HUB_IMAGE_TAG=local
